{
  "description": "Assistant: keeps the working copy its skills run. Roadmap: in a project with a Roadmap writer, the main session is reminded at its next message when it started or messaged a helper before telling the writer, or has not forwarded a helper report; in a project switched to writing its own roadmap, the main session writes it itself, helpers never do, a reply is held once only after a finished helper report the roadmap does not show, and other owed work is a reminder at the next message. Does nothing in a project that has not run /assistant:roadmap-setup. Questions: in a project that ran /assistant:questions-setup, the open questions in Questions.md are shown to each session, and the main session's reply is held once when an answer did not change the file or a new question to the person is not in it (let go after three holds in a row). Talk to your assistant: a session in the assistant's folder that ran /assistant:talk shares the page box's conversation (its words and replies are added to it, and it is shown what the box said).",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/assistant_copy.py"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/reminder.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_blocks.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/questions_blocks.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk_turns.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/assistant_copy.py"
            ],
            "timeout": 60
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk_turns.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/rulebook_guard.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Agent|Task|Workflow|SendMessage|mcp__ccd_session__start_session|mcp__ccd_session_mgmt__send_message|ArtifactData",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_blocks.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/guard_blocks.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Agent|Task|Workflow|SendMessage|mcp__ccd_session__start_session|mcp__ccd_session_mgmt__send_message|ArtifactData|Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_blocks.py"
            ],
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/questions_blocks.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_blocks.py"
            ],
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/roadmap_blocks.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/questions_blocks.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/desk_turns.py"
            ],
            "timeout": 120
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/reminder.py"
            ],
            "timeout": 30
          },
          {
            "type": "command",
            "command": "python",
            "args": [
              "${CLAUDE_PLUGIN_ROOT}/hooks/questions_blocks.py"
            ],
            "timeout": 30
          }
        ]
      }
    ]
  }
}
